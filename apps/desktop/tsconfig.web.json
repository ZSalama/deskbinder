{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/preload/*.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "jsx": "react-jsx",
    "paths": {
      "@deskbinder/convex-client": [
        "../../packages/convex-client/src/index.ts"
      ],
      "@deskbinder/convex-client/*": [
        "../../packages/convex-client/src/*"
      ],
      "@deskbinder/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@deskbinder/shared/*": [
        "../../packages/shared/src/*"
      ],
      "@/*": [
        "./src/renderer/src/*"
      ],
      "@renderer/*": [
        "./src/renderer/src/*"
      ]
    }
  }
}
